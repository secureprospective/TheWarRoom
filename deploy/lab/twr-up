#!/usr/bin/env bash
# Lab only: stand up server CT <ctid> (200-299) with the REAL bundled proxmox.sh on the golden template.
# Usage: twr-up <ctid> <bundle> < tokenfile   (token on stdin; never on argv)
set -euo pipefail
[[ $(hostname) == twr-lab ]] || { echo 'lab only' >&2; exit 97; }
[[ $# == 2 && $1 =~ ^2[0-9]{2}$ && -f $2 ]] || { echo 'usage: twr-up <200-299> <bundle> < tokenfile' >&2; exit 2; }
ctid=$1
bundle=$(realpath "$2")
IFS= read -r token || [[ -n $token ]] || { echo 'no token on stdin' >&2; exit 2; }
cache=/var/lib/vz/template/cache
TWR_TEMPLATE=${TWR_TEMPLATE:-$(find "$cache" -maxdepth 1 -name 'alpine-3.23-twr-golden_*_amd64.tar.gz' -printf '%f\n' | sort -V | tail -1)}
export TWR_TEMPLATE
installer=$(mktemp)
trap 'rm -f "$installer"' EXIT
# The installer that ships inside the bundle, read as one file (the bundle is never unpacked here).
tar -xzOf "$bundle" ./proxmox.sh > "$installer"
start=$SECONDS
printf '%s\n' "$ctid" vmbr1 51 lab-thin local secureprospective.com \
  "twr-lab-$ctid.secureprospective.com" no "$token" | bash "$installer" "$bundle"
unset token
pct set "$ctid" --description "lab bundle $(basename "$bundle")"
echo "twr-up $ctid: $((SECONDS - start)) s"
