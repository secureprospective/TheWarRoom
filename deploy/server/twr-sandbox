#!/bin/sh
set -eu
umask 077
if [ "$#" = 0 ]; then
  set -- /usr/local/bin/twr-server hosted -listen 127.0.0.1:8443 \
  -db /var/lib/twr/server.db -tls-cert /etc/twr/origin.pem \
  -tls-key /etc/twr/origin.key -totp-key-file /etc/twr/authenticator.key \
  -backup-config /etc/twr/backup.json -preview-registry /etc/twr/endpoint-registry.csv -trusted-proxy 127.0.0.1 \
  -status-socket /var/lib/twr/status.sock
  if [ -s /etc/twr/public-host ]; then
    set -- "$@" -public-host "$(cat /etc/twr/public-host)"
  fi
  # A league loaded with `twr-server league-load -football-pin` pins its football evidence here.
  if [ -s /etc/twr/football.sha256 ]; then
    set -- "$@" -football "$(head -c 64 /etc/twr/football.sha256)"
  fi
  # The operator turns on official statistics (twr-server README, "Official statistics") with this file.
  if [ -e /etc/twr/official-stats ]; then
    set -- "$@" -official-stats
  fi
  # The operator opts into the hosted NFL schedule timer with this file.
  if [ -e /etc/twr/nfl-schedule-refresh ]; then
    set -- "$@" -nfl-schedule-refresh
  fi
  # The operator opts into archiving Sleeper stat-line projections (internal rehearsal use only) with this file.
  if [ -e /etc/twr/sleeper-projections ]; then
    set -- "$@" -sleeper-projections
  fi
fi
exec bwrap --unshare-all --share-net --die-with-parent --new-session --cap-drop ALL \
  --ro-bind /usr /usr --ro-bind /lib /lib --ro-bind /bin /bin \
  --ro-bind /etc/twr /etc/twr --ro-bind /etc/ssl/certs /etc/ssl/certs --ro-bind /etc/resolv.conf /etc/resolv.conf --proc /proc --dev /dev \
  --tmpfs /tmp --tmpfs /run --bind /var/lib/twr /var/lib/twr \
  --chdir /var/lib/twr --clearenv --setenv PATH /usr/bin:/bin \
  --setenv HOME /var/lib/twr --setenv TMPDIR /var/lib/twr \
  --setenv GOMEMLIMIT 768MiB --setenv GOMAXPROCS 2 \
  "$@"
