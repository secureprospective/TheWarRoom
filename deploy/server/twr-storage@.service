[Unit]
Description=Encrypted league storage %i
Requires=twr-no-swap.service
After=twr-no-swap.service local-fs.target
Before=twr-container@%i.service

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
LoadCredential=unlock.jwe:/etc/twr-storage/%i.jwe
ExecStart=/usr/local/libexec/twr-storage start %i
ExecStop=/usr/local/libexec/twr-storage stop %i
TimeoutStartSec=90
TimeoutStopSec=90
MemorySwapMax=0
